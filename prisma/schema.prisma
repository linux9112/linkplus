datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model User {
  id                 String    @id @default(uuid()) @db.VarChar(36)
  username           String    @db.VarChar(50)
  normalizedUsername String    @unique @map("normalized_username") @db.VarChar(50)
  email              String    @db.VarChar(255)
  normalizedEmail    String    @unique @map("normalized_email") @db.VarChar(255)
  passwordHash       String    @map("password_hash") @db.VarChar(255)
  role               String    @default("user") @db.VarChar(20)
  status             String    @default("active") @db.VarChar(20)
  emailVerifiedAt    DateTime? @map("email_verified_at") @db.DateTime(3)
  createdAt          DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt          DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  profile                 Profile?
  qrSetting               QrSetting?
  links                   Link[]
  sessions                Session[]
  passwordResetTokens     PasswordResetToken[]
  emailVerificationTokens EmailVerificationToken[]
  submittedReports        ModerationReport[]       @relation("ReporterUser")
  targetedReports         ModerationReport[]       @relation("ReportedUser")
  resolvedReports         ModerationReport[]       @relation("ResolvedByUser")
  adminAuditLogs          AdminAuditLog[]
  updatedPlatformSettings PlatformSetting[]

  @@index([role])
  @@index([status])
  @@map("users")
}

model Profile {
  id            String   @id @default(uuid()) @db.VarChar(36)
  userId        String   @unique @map("user_id") @db.VarChar(36)
  displayName   String   @default("") @map("display_name") @db.VarChar(100)
  bio           String?  @db.Text
  avatarUrl     String?  @map("avatar_url") @db.VarChar(1000)
  themeSettings Json     @map("theme_settings")
  socialLinks   Json     @map("social_links")
  isPublic      Boolean  @default(true) @map("is_public")
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt     DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  user            User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyticsEvents AnalyticsEvent[]

  @@index([isPublic])
  @@map("profiles")
}

model Link {
  id             String    @id @default(uuid()) @db.VarChar(36)
  userId         String    @map("user_id") @db.VarChar(36)
  title          String    @db.VarChar(255)
  destinationUrl String    @map("destination_url") @db.VarChar(2048)
  description    String?   @db.Text
  icon           String?   @db.VarChar(100)
  thumbnailUrl   String?   @map("thumbnail_url") @db.VarChar(1000)
  position       Int       @default(0)
  isActive       Boolean   @default(true) @map("is_active")
  isPinned       Boolean   @default(false) @map("is_pinned")
  isHidden       Boolean   @default(false) @map("is_hidden")
  isFeatured     Boolean   @default(false) @map("is_featured")
  category       String?   @db.VarChar(100)
  customLabel    String?   @map("custom_label") @db.VarChar(100)
  backgroundColor String?  @map("background_color") @db.VarChar(50)
  textColor       String?  @map("text_color") @db.VarChar(50)
  mediaType      String?   @map("media_type") @db.VarChar(50)
  mediaUrl       String?   @map("media_url") @db.VarChar(2048)
  utmParams      Json?     @map("utm_params")
  clickCount     Int       @default(0) @map("click_count")
  scheduledStart DateTime? @map("scheduled_start") @db.DateTime(3)
  scheduledEnd   DateTime? @map("scheduled_end") @db.DateTime(3)
  createdAt      DateTime  @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt      DateTime  @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  user              User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  analyticsEvents   AnalyticsEvent[]
  moderationReports ModerationReport[]

  @@index([userId, position])
  @@index([userId, isActive, isHidden, isPinned])
  @@index([scheduledStart, scheduledEnd])
  @@index([userId, category])
  @@map("links")
}

model QrSetting {
  id                    String   @id @default(uuid()) @db.VarChar(36)
  userId                String   @unique @map("user_id") @db.VarChar(36)
  foregroundColor       String   @default("#000000") @map("foreground_color") @db.VarChar(50)
  backgroundColor       String   @default("#ffffff") @map("background_color") @db.VarChar(50)
  gradientSettings      Json?    @map("gradient_settings")
  dotStyle              String   @default("squares") @map("dot_style") @db.VarChar(50)
  cornerStyle           String   @default("square") @map("corner_style") @db.VarChar(50)
  logoUrl               String?  @map("logo_url") @db.VarChar(1000)
  errorCorrectionLevel  String   @default("H") @map("error_correction_level") @db.VarChar(5)
  margin                Int      @default(2)
  resolution            Int      @default(1024)
  transparentBackground Boolean  @default(false) @map("transparent_background")
  presetName            String?  @map("preset_name") @db.VarChar(100)
  createdAt             DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt             DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("qr_settings")
}

model AnalyticsEvent {
  id               String   @id @default(uuid()) @db.VarChar(36)
  profileId        String   @map("profile_id") @db.VarChar(36)
  linkId           String?  @map("link_id") @db.VarChar(36)
  eventType        String   @map("event_type") @db.VarChar(50)
  referrerCategory String   @default("direct") @map("referrer_category") @db.VarChar(50)
  deviceCategory   String   @default("desktop") @map("device_category") @db.VarChar(50)
  campaignId       String?  @map("campaign_id") @db.VarChar(100)
  visitorHash      String?  @map("visitor_hash") @db.VarChar(64)
  countryCode      String?  @map("country_code") @db.VarChar(10)
  createdAt        DateTime @default(now()) @map("created_at") @db.DateTime(3)

  profile Profile @relation(fields: [profileId], references: [id], onDelete: Cascade)
  link    Link?   @relation(fields: [linkId], references: [id], onDelete: Cascade)

  @@index([profileId, createdAt])
  @@index([linkId, createdAt])
  @@index([profileId, eventType, createdAt])
  @@index([profileId, referrerCategory])
  @@index([profileId, deviceCategory])
  @@index([createdAt])
  @@map("analytics_events")
}

model PasswordResetToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("password_reset_tokens")
}

model EmailVerificationToken {
  id        String    @id @default(uuid()) @db.VarChar(36)
  userId    String    @map("user_id") @db.VarChar(36)
  tokenHash String    @unique @map("token_hash") @db.VarChar(255)
  expiresAt DateTime  @map("expires_at") @db.DateTime(3)
  usedAt    DateTime? @map("used_at") @db.DateTime(3)
  createdAt DateTime  @default(now()) @map("created_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, expiresAt])
  @@map("email_verification_tokens")
}

model Session {
  id        String   @id @db.VarChar(128)
  userId    String   @map("user_id") @db.VarChar(36)
  data      Json?
  expiresAt DateTime @map("expires_at") @db.DateTime(3)
  createdAt DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model ModerationReport {
  id              String   @id @default(uuid()) @db.VarChar(36)
  reporterUserId  String?  @map("reporter_user_id") @db.VarChar(36)
  reportedUserId  String   @map("reported_user_id") @db.VarChar(36)
  reportedLinkId  String?  @map("reported_link_id") @db.VarChar(36)
  reason          String   @db.VarChar(255)
  details         String?  @db.Text
  status          String   @default("pending") @db.VarChar(50)
  resolvedBy      String?  @map("resolved_by") @db.VarChar(36)
  resolutionNotes String?  @map("resolution_notes") @db.Text
  createdAt       DateTime @default(now()) @map("created_at") @db.DateTime(3)
  updatedAt       DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  reporter     User? @relation("ReporterUser", fields: [reporterUserId], references: [id], onDelete: SetNull)
  reportedUser User  @relation("ReportedUser", fields: [reportedUserId], references: [id], onDelete: Cascade)
  reportedLink Link? @relation(fields: [reportedLinkId], references: [id], onDelete: SetNull)
  resolvedUser User? @relation("ResolvedByUser", fields: [resolvedBy], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@index([reportedUserId])
  @@index([reportedLinkId])
  @@map("moderation_reports")
}

model AdminAuditLog {
  id            String   @id @default(uuid()) @db.VarChar(36)
  adminUserId   String   @map("admin_user_id") @db.VarChar(36)
  action        String   @db.VarChar(100)
  targetType    String   @map("target_type") @db.VarChar(50)
  targetId      String?  @map("target_id") @db.VarChar(36)
  details       Json?
  ipAddressHash String?  @map("ip_address_hash") @db.VarChar(64)
  createdAt     DateTime @default(now()) @map("created_at") @db.DateTime(3)

  adminUser User @relation(fields: [adminUserId], references: [id], onDelete: Cascade)

  @@index([adminUserId, createdAt])
  @@index([action, createdAt])
  @@index([targetType, targetId])
  @@map("admin_audit_logs")
}

model PlatformSetting {
  key         String   @id @db.VarChar(100)
  value       String   @db.Text
  description String?  @db.VarChar(255)
  isPublic    Boolean  @default(false) @map("is_public")
  updatedBy   String?  @map("updated_by") @db.VarChar(36)
  updatedAt   DateTime @default(now()) @updatedAt @map("updated_at") @db.DateTime(3)

  adminUser User? @relation(fields: [updatedBy], references: [id], onDelete: SetNull)

  @@index([isPublic])
  @@map("platform_settings")
}
