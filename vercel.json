{
  "version": 2,
  "buildCommand": "vite build",
  "outputDirectory": "dist/client",
  "framework": "vite",
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/api"
    },
    {
      "source": "/r/(.*)",
      "destination": "/api"
    },
    {
      "source": "/((?!api/|r/).*)",
      "destination": "/index.html"
    }
  ]
}
